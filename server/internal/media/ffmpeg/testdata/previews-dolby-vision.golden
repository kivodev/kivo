ffmpeg -hide_banner -nostats -loglevel warning -nostdin -y -threads 1 -skip_frame nokey -bsf:0 dovi_rpu=strip=1 -protocol_whitelist file -i file:/media/dv7.mkv -filter_complex '[0:0]setparams=color_primaries=bt2020:color_trc=smpte2084:colorspace=bt2020nc,fps=fps=1/10,scale=w=320:h=134,tonemapx=tonemap=bt2390:desat=0:peak=100:t=bt709:m=bt709:p=bt709:format=yuv420p,tile=10x10[v]' -map '[v]' -fps_mode passthrough -c:v libwebp -quality 70 -f image2 -start_number 0 file:/cache/previews/sheet-%d.webp
