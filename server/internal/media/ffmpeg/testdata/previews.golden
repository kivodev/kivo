ffmpeg -hide_banner -nostats -loglevel warning -nostdin -y -threads 1 -skip_frame nokey -protocol_whitelist file -i file:/media/a.mkv -filter_complex '[0:0]setparams=color_primaries=bt709:color_trc=bt709:colorspace=bt709,fps=fps=1/10,scale=w=320:h=180,tile=10x10[v]' -map '[v]' -fps_mode passthrough -c:v libwebp -quality 70 -f image2 -start_number 0 file:/cache/previews/sheet-%d.webp
