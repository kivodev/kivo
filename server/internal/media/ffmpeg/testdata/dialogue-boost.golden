ffmpeg -hide_banner -nostats -loglevel warning -copyts -protocol_whitelist file -i file:/media/a.mkv -map 0:0 -c:v copy -map 0:1 -c:a:0 aac -filter:a:0 'aformat=channel_layouts=5.1|5.1(side),pan=stereo|c0=c2+0.30*c0+0.30*c4|c1=c2+0.30*c1+0.30*c5,acompressor=threshold=-30dB:ratio=3:attack=5:release=250:makeup=8dB,alimiter=limit=-1dB:level=false' -ac:a:0 2 -ar:a:0 48000 -b:a:0 128000 -map 0:2 -c:a:1 aac -filter:a:1 'aformat=channel_layouts=5.1|5.1(side),pan=5.1|c0=c0|c1=c1|c2=1.6*c2|c3=c3|c4=c4|c5=c5,acompressor=threshold=-30dB:ratio=3:attack=5:release=250:makeup=8dB,alimiter=limit=-1dB:level=false' -ac:a:1 6 -ar:a:1 48000 -b:a:1 384000 -map 0:3 -c:a:2 aac -filter:a:2 acompressor=threshold=-30dB:ratio=3:attack=5:release=250:makeup=8dB,alimiter=limit=-1dB:level=false -ac:a:2 2 -ar:a:2 48000 -b:a:2 128000 -map 0:4 -c:a:3 aac -filter:a:3 acompressor=threshold=-30dB:ratio=3:attack=5:release=250:makeup=8dB,alimiter=limit=-1dB:level=false -ac:a:3 1 -ar:a:3 48000 -b:a:3 64000 -map_metadata -1 -map_chapters -1 -max_muxing_queue_size 2048 -avoid_negative_ts disabled -output_ts_offset 10 -use_editlist 0 -movflags +frag_keyframe+empty_moov+default_base_moof+frag_discont -f mp4 pipe:1
