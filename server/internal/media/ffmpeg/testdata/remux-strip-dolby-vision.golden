ffmpeg -hide_banner -nostats -loglevel warning -copyts -protocol_whitelist file -i file:/media/dv7.mkv -map 0:0 -c:v copy -bsf:v dovi_rpu=strip=1 -map 0:1 -c:a:0 copy -map_metadata -1 -map_chapters -1 -max_muxing_queue_size 2048 -avoid_negative_ts disabled -output_ts_offset 10 -use_editlist 0 -movflags +frag_keyframe+empty_moov+default_base_moof+frag_discont -f mp4 pipe:1
