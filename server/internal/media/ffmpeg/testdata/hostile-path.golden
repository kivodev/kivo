ffmpeg -hide_banner -nostats -loglevel warning -copyts -protocol_whitelist file -i 'file:concat:/etc/passwd|-y '\''x'\''.mkv' -map 0:0 -c:v copy -map_metadata -1 -map_chapters -1 -max_muxing_queue_size 2048 -avoid_negative_ts disabled -output_ts_offset 10 -use_editlist 0 -movflags +frag_keyframe+empty_moov+default_base_moof+frag_discont -f mp4 pipe:1
