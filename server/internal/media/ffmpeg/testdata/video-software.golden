# h264-720p
ffmpeg -hide_banner -nostats -loglevel warning -ss 756 -copyts -protocol_whitelist file -i file:/media/Movies/Film.mkv -filter_complex '[0:0]setparams=color_primaries=bt709:color_trc=bt709:colorspace=bt709,scale=w=1280:h=720,format=yuv420p[v]' -map '[v]' -c:v libx264 -profile:v high -preset faster -b:v 3800000 -maxrate:v 4000000 -bufsize:v 8000000 -sc_threshold 0 -flags:v +cgop -force_key_frames:v 'expr:gte(t,n_forced*6)' -forced-idr 1 -g:v 288 -map 0:1 -c:a:0 aac -ac:a:0 2 -b:a:0 192000 -map_metadata -1 -map_chapters -1 -max_muxing_queue_size 2048 -avoid_negative_ts disabled -output_ts_offset 10 -use_editlist 0 -movflags +frag_keyframe+empty_moov+default_base_moof+frag_discont -f mp4 pipe:1
