ffmpeg -hide_banner -nostats -loglevel warning -nostdin -y -protocol_whitelist file -i file:/data/cache/images/tmp/poster.jpg -filter_complex '[0:v]split=4[s0][s1][s2][st];[s0]scale=w='\''min(240,iw)'\'':h=-1[o0];[s1]scale=w='\''min(480,iw)'\'':h=-1[o1];[s2]scale=w='\''min(960,iw)'\'':h=-1[o2];[st]scale=w=32:h=-1[tiny]' -map '[o0]' -frames:v 1 -c:v libwebp -quality 80 -f webp file:/data/cache/images/p240.webp.tmp -map '[o1]' -frames:v 1 -c:v libwebp -quality 80 -f webp file:/data/cache/images/p480.webp.tmp -map '[o2]' -frames:v 1 -c:v libwebp -quality 80 -f webp file:/data/cache/images/p960.webp.tmp -map '[tiny]' -frames:v 1 -c:v png -f image2pipe pipe:1
