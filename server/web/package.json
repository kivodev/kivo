{
  "name": "kivo-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "KIVO_MOCK=1 VITE_KIVO_MOCK=1 vite",
    "build": "vite build && node scripts/check-builds.ts",
    "build:packaged": "KIVO_TIZEN=1 VITE_KIVO_TV=1 VITE_KIVO_PACKAGED=1 vite build",
    "build:packaged:webos": "VITE_KIVO_TV=1 VITE_KIVO_PACKAGED=1 vite build",
    "typecheck": "tsc",
    "lint": "biome check . && eslint . && node scripts/lint-styles.ts",
    "format": "biome check --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:remote": "playwright test -c playwright.remote.config.ts",
    "e2e:tv": "playwright test -c playwright.tv.config.ts",
    "e2e:mock": "playwright test -c playwright.mock.config.ts",
    "e2e:packaged": "playwright test -c playwright.packaged.config.ts",
    "e2e:packaged-file": "npm run build:packaged && playwright test -c playwright.packaged-file.config.ts",
    "tokens": "node scripts/tokens.ts",
    "i18n:extract": "lingui extract --clean",
    "check:generated": "npm run tokens && npm run i18n:extract && git diff --exit-code -- src/theme/tokens.css src/i18n/locales"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@lingui/core": "6.9.1",
    "@lingui/react": "6.9.1",
    "@noriginmedia/norigin-spatial-navigation": "3.3.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-virtual": "3.14.14",
    "blurhash": "2.0.5",
    "hls.js": "1.7.3",
    "jassub": "2.5.16",
    "libpgs": "0.9.0",
    "openapi-fetch": "0.17.0",
    "openapi-react-query": "0.5.4",
    "react": "19.3.0",
    "react-aria": "3.53.0",
    "react-aria-components": "1.22.0",
    "react-dom": "19.3.0",
    "uqr": "0.1.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@biomejs/biome": "2.5.15",
    "@lingui/cli": "6.9.1",
    "@lingui/format-po": "6.9.1",
    "@lingui/vite-plugin": "6.9.1",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.2",
    "msw": "3.0.2",
    "openapi-msw": "2.1.0",
    "postcss": "8.5.29",
    "rollup-plugin-license": "3.7.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
