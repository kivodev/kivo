{
  "font": {
    "sans": "\"Inter Variable\", \"Inter\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
  },
  "text": {
    "xs": { "size": "0.75rem", "lineHeight": "1rem" },
    "sm": { "size": "0.875rem", "lineHeight": "1.25rem" },
    "base": { "size": "1rem", "lineHeight": "1.5rem" },
    "lg": { "size": "1.125rem", "lineHeight": "1.75rem" },
    "xl": { "size": "1.375rem", "lineHeight": "1.875rem" },
    "2xl": { "size": "1.75rem", "lineHeight": "2.25rem" },
    "3xl": { "size": "2.25rem", "lineHeight": "2.5rem" }
  },
  "fontWeight": {
    "normal": "400",
    "medium": "500",
    "semibold": "600",
    "bold": "700"
  },
  "spacing": "0.25rem",
  "radius": {
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "full": "9999px"
  },
  "aspect": {
    "poster": "2 / 3",
    "landscape": "16 / 9",
    "square": "1 / 1"
  },
  "breakpoint": {
    "sm": "40rem",
    "md": "48rem",
    "lg": "64rem",
    "xl": "80rem",
    "2xl": "96rem"
  },
  "container": {
    "prose": "40rem",
    "form": "28rem",
    "page": "96rem",
    "settings-split": "46rem"
  },
  "duration": {
    "fast": "150ms",
    "fade": "200ms"
  },
  "ease": {
    "standard": "cubic-bezier(0.2, 0, 0, 1)",
    "out": "cubic-bezier(0, 0, 0.2, 1)"
  },
  "layout": {
    "sidebarWidth": "15rem",
    "sidebarCollapsedWidth": "4.5rem",
    "bottomBarHeight": "4rem",
    "safeAreaTop": "env(safe-area-inset-top)",
    "safeAreaBottom": "env(safe-area-inset-bottom)",
    "safeAreaLeft": "env(safe-area-inset-left)",
    "safeAreaRight": "env(safe-area-inset-right)",
    "bottomBarInset": "calc(var(--layout-bottom-bar-height) + var(--layout-safe-area-bottom))",
    "bottomBarPaddingLeft": "calc(0.5rem + var(--layout-safe-area-left))",
    "bottomBarPaddingRight": "calc(0.5rem + var(--layout-safe-area-right))",
    "posterMinWidth": "9.5rem",
    "landscapeMinWidth": "15rem",
    "gridGap": "1rem",
    "posterGrid": "repeat(auto-fill, minmax(var(--layout-poster-min-width), 1fr))",
    "landscapeGrid": "repeat(auto-fill, minmax(var(--layout-landscape-min-width), 1fr))",
    "heroMinHeight": "28rem",
    "stillWidth": "10rem",
    "cardCaptionHeight": "3rem",
    "listRowHeight": "3.5rem",
    "railWidth": "1.75rem",
    "playerPanelWidth": "26rem",
    "upNextWidth": "20rem",
    "castRemoteWidth": "36rem",
    "miniPlayerHeight": "4.5rem",
    "miniPlayerInset": "calc(var(--layout-mini-player-height) + var(--layout-safe-area-bottom))",
    "screenHeightFallback": "100vh",
    "bottomBarAndMiniPlayerHeight": "calc(var(--layout-bottom-bar-inset) + var(--layout-mini-player-height))",
    "chapterListHeight": "32rem",
    "nowPlayingWidth": "56rem",
    "settingsWidth": "60rem",
    "settingsAsideWidth": "15rem",
    "settingsFieldWidth": "16rem",
    "settingsSectionGrid": "var(--layout-settings-aside-width) minmax(0, 1fr)",
    "focusRingWidth": "2px",
    "focusRingOffset": "2px"
  },
  "tv": {
    "text": {
      "sm": { "size": "24px", "lineHeight": "32px" },
      "base": { "size": "28px", "lineHeight": "40px" },
      "lg": { "size": "32px", "lineHeight": "44px" },
      "xl": { "size": "40px", "lineHeight": "52px" },
      "title": { "size": "48px", "lineHeight": "60px" },
      "display": { "size": "72px", "lineHeight": "88px" }
    },
    "focusRingWidth": "4px",
    "focusScale": "1.05",
    "cardFocusScale": "1.1",
    "web": {
      "text": {
        "xs": "sm",
        "sm": "sm",
        "base": "base",
        "lg": "lg",
        "xl": "xl",
        "2xl": "title",
        "3xl": "display"
      },
      "duration": {
        "fast": "0ms",
        "glide": "250ms"
      },
      "layout": {
        "overscanX": "48px",
        "overscanY": "32px",
        "railLeft": "16px",
        "railItemSize": "64px",
        "railCollapsedWidth": "calc(var(--layout-tv-rail-left) + var(--layout-tv-rail-item-size))",
        "railInset": "8px",
        "railOpenWidth": "480px",
        "railOpenPaddingX": "calc(var(--layout-tv-rail-left) - var(--layout-tv-rail-inset))",
        "railOpenPaddingY": "calc(var(--layout-tv-overscan-y) - var(--layout-tv-rail-inset))",
        "contentLeft": "calc(var(--layout-tv-rail-collapsed-width) + 32px)",
        "letterRailTop": "calc(var(--layout-tv-overscan-y) + 135px)",
        "listRevealMargin": "calc(var(--layout-tv-overscan-y) + 216px)",
        "rowBleed": "72px",
        "rowGap": "56px",
        "rowEnd": "calc(var(--layout-tv-overscan-x) + 2rem)",
        "homeLastRowHeight": "calc(100vh - 2 * var(--layout-tv-overscan-y) - 1.5rem)",
        "noticeDockedBottom": "calc(var(--layout-mini-player-height) + var(--layout-tv-overscan-y) + 1.5rem)",
        "heroMinHeight": "20rem",
        "cardCaptionShift": "16px",
        "posterAcross": "6",
        "landscapeAcross": "3"
      },
      "shadow": {
        "cardFocus": "inset 0 64px 48px -32px #ffffff2e, 0 0 40px 4px #ffffff52, 0 28px 56px -12px #000000f2",
        "cardFocusSheen": "inset 0 64px 48px -32px #ffffff2e",
        "cardFocusGlow": "0 0 40px 4px #ffffff52, 0 28px 56px -12px #000000f2"
      }
    }
  },
  "themes": {
    "dark": {
      "scheme": "dark",
      "color": {
        "bg": "#0d0e12",
        "surface": "#15171d",
        "surface-raised": "#1d2028",
        "surface-hover": "#262a34",
        "border": "#2c303b",
        "text": "#eceef2",
        "text-muted": "#9da3af",
        "text-subtle": "#6d7380",
        "accent": "#8b9cff",
        "accent-hover": "#a3b1ff",
        "on-accent": "#0d0e12",
        "danger": "#f0656b",
        "warning": "#f2b84b",
        "success": "#4cc38a",
        "focus": "#ffffff",
        "scrim": "#0d0e12d9",
        "scrim-soft": "#0d0e1266",
        "badge": "#000000b3",
        "on-badge": "#ffffff",
        "placeholder": "#23262f",
        "on-placeholder": "#9da3af",
        "progress-track": "#ffffff40",
        "progress": "#8b9cff",
        "player": "#000000",
        "on-player": "#ffffff",
        "on-player-muted": "#ffffffb3",
        "player-scrim": "#000000b3",
        "player-panel": "#15171df2",
        "player-track": "#ffffff4d",
        "subtitle-box": "#000000bf"
      },
      "shadow": {
        "card": "0 2px 8px #00000066",
        "overlay": "0 12px 32px #00000099",
        "subtitle": "0 0 4px #000000, 0 1px 2px #000000"
      }
    },
    "light": {
      "scheme": "light",
      "color": {
        "bg": "#f6f7f9",
        "surface": "#ffffff",
        "surface-raised": "#ffffff",
        "surface-hover": "#eceef2",
        "border": "#d9dce3",
        "text": "#14161b",
        "text-muted": "#555b67",
        "text-subtle": "#7c8290",
        "accent": "#3f51d9",
        "accent-hover": "#3343bd",
        "on-accent": "#ffffff",
        "danger": "#c9343b",
        "warning": "#a86b00",
        "success": "#1f8a57",
        "focus": "#14161b",
        "scrim": "#f6f7f9e6",
        "scrim-soft": "#f6f7f966",
        "badge": "#000000b3",
        "on-badge": "#ffffff",
        "placeholder": "#e3e5ea",
        "on-placeholder": "#555b67",
        "progress-track": "#00000033",
        "progress": "#3f51d9",
        "player": "#000000",
        "on-player": "#ffffff",
        "on-player-muted": "#ffffffb3",
        "player-scrim": "#000000b3",
        "player-panel": "#15171df2",
        "player-track": "#ffffff4d",
        "subtitle-box": "#000000bf"
      },
      "shadow": {
        "card": "0 1px 4px #0000001f",
        "overlay": "0 12px 32px #00000033",
        "subtitle": "0 0 4px #000000, 0 1px 2px #000000"
      }
    }
  }
}
