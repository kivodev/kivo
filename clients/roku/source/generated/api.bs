    interface Accelerator
        id as string
        backend as AcceleratorBackend
        name as string
        encoders as AcceleratorEncoder[]
        decoders as AcceleratorFormat[]
        optional toneMap as ProcessedOn
        optional burnIn as ProcessedOn
        optional problem as AcceleratorProblem
    end interface

