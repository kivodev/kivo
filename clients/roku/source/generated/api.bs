        codec as EncoderCodec
    end interface

    interface AcceleratorFormat
        codec as string
        bitDepth as integer
    end interface

    interface AcceleratorList
        tested as boolean
        items as Accelerator[]
    end interface

    interface AcceleratorProblem
        reason as AcceleratorProblemReason
        optional detail as string
    end interface

    interface Accepted
        optional queued as integer
    end interface

