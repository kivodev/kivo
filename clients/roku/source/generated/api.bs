    function checkDownloads(body as KivoApi.DownloadCheck) as KivoApi.Request
        return { method: "POST", path: "/api/v1/downloads/check", query: invalid, body: body, contentType: "application/json", auth: true }
    end function

    ' checkDownloads's answer, as its type.
    function checkDownloadsAnswer(response as object) as KivoApi.DownloadCheckResult
        return response.body
    end function

    ' Estimate downloads: POST /api/v1/downloads/estimate.
    function estimateDownloads(body as KivoApi.DownloadEstimateRequest) as KivoApi.Request
        return { method: "POST", path: "/api/v1/downloads/estimate", query: invalid, body: body, contentType: "application/json", auth: true }
    end function

    ' estimateDownloads's answer, as its type.
    function estimateDownloadsAnswer(response as object) as KivoApi.DownloadEstimateList
        return response.body
    end function

    ' List downloads: GET /api/v1/downloads.
    function listDownloads() as KivoApi.Request
        return { method: "GET", path: "/api/v1/downloads", query: invalid, body: invalid, contentType: invalid, auth: true }
    end function

    ' listDownloads's answer, as its type.
    function listDownloadsAnswer(response as object) as KivoApi.DownloadList
        return response.body
    end function

    ' Create download: POST /api/v1/downloads.
    function createDownload(body as KivoApi.DownloadCreate) as KivoApi.Request
        return { method: "POST", path: "/api/v1/downloads", query: invalid, body: body, contentType: "application/json", auth: true }
    end function

    ' createDownload's answer, as its type.
    function createDownloadAnswer(response as object) as KivoApi.Download
        return response.body
    end function

    ' Get download: GET /api/v1/downloads/{id}.
    function getDownload(id as string) as KivoApi.Request
        return { method: "GET", path: "/api/v1/downloads/" + KivoApi.pathEscape(id), query: invalid, body: invalid, contentType: invalid, auth: true }
    end function

    ' getDownload's answer, as its type.
    function getDownloadAnswer(response as object) as KivoApi.Download
        return response.body
    end function

    ' Delete download: DELETE /api/v1/downloads/{id}.
    function deleteDownload(id as string) as KivoApi.Request
        return { method: "DELETE", path: "/api/v1/downloads/" + KivoApi.pathEscape(id), query: invalid, body: invalid, contentType: invalid, auth: true }
    end function

    ' Retry download: POST /api/v1/downloads/{id}/retry.
    function retryDownload(id as string) as KivoApi.Request
        return { method: "POST", path: "/api/v1/downloads/" + KivoApi.pathEscape(id) + "/retry", query: invalid, body: invalid, contentType: invalid, auth: true }
    end function

    ' retryDownload's answer, as its type.
    function retryDownloadAnswer(response as object) as KivoApi.Download
        return response.body
    end function

    ' Get download file: GET /api/v1/downloads/{id}/files/{part}.
    function getDownloadFile(id as string, part as string) as KivoApi.Request
        return { method: "GET", path: "/api/v1/downloads/" + KivoApi.pathEscape(id) + "/files/" + KivoApi.pathEscape(part), query: invalid, body: invalid, contentType: invalid, auth: true }
    end function

    ' getDownloadFile's URL from the server address [base], for a node that fetches its video/* itself.
    function getDownloadFileUrl(base as string, id as string, part as string) as string
        request = KivoApi.getDownloadFile(id, part)
        return base + request.path + KivoApi.queryString(request.query)
    end function

    ' Get download subtitle: GET /api/v1/downloads/{id}/subtitles/{name}.
    function getDownloadSubtitle(id as string, name as string) as KivoApi.Request
        return { method: "GET", path: "/api/v1/downloads/" + KivoApi.pathEscape(id) + "/subtitles/" + KivoApi.pathEscape(name), query: invalid, body: invalid, contentType: invalid, auth: true }
    end function

    ' getDownloadSubtitle's URL from the server address [base], for a node that fetches its text/vtt itself.
    function getDownloadSubtitleUrl(base as string, id as string, name as string) as string
        request = KivoApi.getDownloadSubtitle(id, name)
        return base + request.path + KivoApi.queryString(request.query)
    end function

    ' Get font: GET /api/v1/fonts/{sha256}.
    function getFont(sha256 as string) as KivoApi.Request
        return { method: "GET", path: "/api/v1/fonts/" + KivoApi.pathEscape(sha256), query: invalid, body: invalid, contentType: invalid, auth: true }
    end function

    ' getFont's URL from the server address [base], for a node that fetches its font/ttf itself.
    function getFontUrl(base as string, sha256 as string) as string
        request = KivoApi.getFont(sha256)
        return base + request.path + KivoApi.queryString(request.query)
    end function

    ' Get image: GET /api/v1/images/{id}.
    ' Query: width.
    function getImage(id as string, query = invalid as KivoApi.GetImageQuery) as KivoApi.Request
        return { method: "GET", path: "/api/v1/images/" + KivoApi.pathEscape(id), query: query, body: invalid, contentType: invalid, auth: true }
    end function

    ' getImage's URL from the server address [base], for a node that fetches its image/webp itself.
    function getImageUrl(base as string, id as string, query = invalid as KivoApi.GetImageQuery) as string
        request = KivoApi.getImage(id, query)
        return base + request.path + KivoApi.queryString(request.query)
    end function

    ' Get metrics: GET /api/v1/metrics.
    function getMetrics() as KivoApi.Request
        return { method: "GET", path: "/api/v1/metrics", query: invalid, body: invalid, contentType: invalid, auth: true }
    end function

    ' getMetrics's URL from the server address [base], for a node that fetches its text/plain itself.
    function getMetricsUrl(base as string) as string
        request = KivoApi.getMetrics()
        return base + request.path + KivoApi.queryString(request.query)
    end function

    ' List log lines: GET /api/v1/logs.
    ' Query: level, q, after, limit.
    function listLogs(query = invalid as KivoApi.ListLogsQuery) as KivoApi.Request
        return { method: "GET", path: "/api/v1/logs", query: query, body: invalid, contentType: invalid, auth: true }
    end function

