        return { method: "POST", path: "/api/v1/downloads/check", query: invalid, body: body, contentType: "application/json", auth: true }
    end function

    ' checkDownloads's answer, as its type.
    function checkDownloadsAnswer(response as object) as KivoApi.DownloadCheckResult
        return response.body
    end function

