        return response.body
    end function

    ' Get download file: GET /api/v1/downloads/{id}/files/{part}.
    function getDownloadFile(id as string, part as string) as KivoApi.Request
        return { method: "GET", path: "/api/v1/downloads/" + KivoApi.pathEscape(id) + "/files/" + KivoApi.pathEscape(part), query: invalid, body: invalid, contentType: invalid, auth: true }
    end function

    ' getDownloadFile's URL from the server address [base], for a node that fetches its video/* itself.
    function getDownloadFileUrl(base as string, id as string, part as string) as string
        request = KivoApi.getDownloadFile(id, part)
        return base + request.path + KivoApi.queryString(request.query)
    end function

