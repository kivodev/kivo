        return response.body
    end function

    ' Get download: GET /api/v1/downloads/{id}.
    function getDownload(id as string) as KivoApi.Request
        return { method: "GET", path: "/api/v1/downloads/" + KivoApi.pathEscape(id), query: invalid, body: invalid, contentType: invalid, auth: true }
    end function

    ' getDownload's answer, as its type.
    function getDownloadAnswer(response as object) as KivoApi.Download
        return response.body
    end function

    ' Delete download: DELETE /api/v1/downloads/{id}.
    function deleteDownload(id as string) as KivoApi.Request
        return { method: "DELETE", path: "/api/v1/downloads/" + KivoApi.pathEscape(id), query: invalid, body: invalid, contentType: invalid, auth: true }
    end function

    ' Retry download: POST /api/v1/downloads/{id}/retry.
    function retryDownload(id as string) as KivoApi.Request
        return { method: "POST", path: "/api/v1/downloads/" + KivoApi.pathEscape(id) + "/retry", query: invalid, body: invalid, contentType: invalid, auth: true }
    end function

    ' retryDownload's answer, as its type.
