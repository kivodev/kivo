import "pkg:/source/generated/api.bs"
import "pkg:/source/generated/tokens.bs"
import "pkg:/source/shared/content.bs"
import "pkg:/source/shared/display.bs"
import "pkg:/source/shared/session.bs"
import "pkg:/source/shared/tracks.bs"
import "pkg:/source/shared/ui.bs"

sub init()
    m.backdrop = m.top.FindNode("backdrop")
    m.title = m.top.FindNode("title")
    m.details = m.top.FindNode("details")
    m.overview = m.top.FindNode("overview")
    m.buttons = m.top.FindNode("buttons")
    m.status = m.top.FindNode("status")
    m.rows = m.top.FindNode("rows")
    KivoUi.style(m.top.FindNode("hint"), KivoTokens.TextSize.sm, KivoTokens.Color.textSubtle)
    m.top.FindNode("scrim").color = KivoTokens.Color.scrim
    KivoUi.style(m.title, KivoTokens.TextSize.title, KivoTokens.Color.text, true)
    KivoUi.style(m.details, KivoTokens.TextSize.base, KivoTokens.Color.textMuted)
    KivoUi.style(m.overview, KivoTokens.TextSize.base, KivoTokens.Color.text)
    KivoUi.style(m.status, KivoTokens.TextSize.base, KivoTokens.Color.textMuted)
    font = CreateObject("roSGNode", "Font")
    font.uri = "font:BoldSystemFontFile"
    font.size = KivoTokens.TextSize.base
    m.rows.rowLabelFont = font
    m.rows.rowLabelColor = KivoTokens.Color.text
    m.buttons.ObserveField("buttonSelected", "onButton")
    m.rows.ObserveField("rowItemSelected", "onCard")
    m.seasons = invalid
    m.menu = m.top.FindNode("menu")
    m.menu.ObserveField("chosen", "onMenuChosen")
    m.menu.ObserveField("closed", "onMenuClosed")
    ' A movie's picks, which apply to its next play only.
    m.choice = {}
    m.tasks = {}
    m.top.ObserveField("params", "load")
end sub

sub focus()
    takeFocus()
    ' Progress may have moved on while the player showed.
    if m.work <> invalid then load()
end sub

sub takeFocus()
    if m.menu.visible
        m.menu.callFunc("focus")
    else if m.buttons.buttons.Count() > 0
        m.buttons.SetFocus(true)
    else if m.rows.visible
        m.rows.SetFocus(true)
    else
        m.top.SetFocus(true)
    end if
end sub

sub load()
    m.tasks.work = Kivo.send(KivoApi.getWork(m.top.params.id), "onWork")
end sub

sub onWork(event as object)
    response = event.GetData()
    m.tasks.work = invalid
    if response.code = 401
        m.top.navigate = { signedOut: true }
        return
    end if
    if response.code <> 200
        m.status.text = KivoDisplay.problem(response)
        return
    end if
    first = m.work = invalid
    m.work = response.body
    show(m.work)
    if m.work.kind = KivoApi.WorkKind.series or m.work.kind = KivoApi.WorkKind.season
        ' Episodes' progress moves on too, so they're read again each time.
        m.tasks.children = Kivo.send(KivoApi.listWorkChildren(m.work.id), "onChildren")
    else
        showRows()
    end if
    if first then takeFocus()
end sub

sub show(work as object)
    m.title.text = work.title
    m.details.text = details(work).Join("  ·  ")
    if work.overview <> invalid then m.overview.text = work.overview
    m.backdrop.uri = Kivo.imageUrl(work.images.backdrop, 1920)
    labels = []
    m.actions = []
    target = playTarget(work)
    if target <> invalid
        if target.positionMs <> invalid and target.positionMs > 0
            labels.Push("Resume")
            m.actions.Push({ id: target.id, fromStart: false })
            labels.Push("Play from beginning")
            m.actions.Push({ id: target.id, fromStart: true })
        else
            labels.Push("Play")
            m.actions.Push({ id: target.id, fromStart: false })
        end if
    end if
    if target <> invalid and target.id = work.id and work.kind <> KivoApi.WorkKind.book and picksTracks(work)
        labels.Push("Audio & Subtitles")
        m.actions.Push({ tracks: true })
    end if
    focused = m.buttons.buttonFocused
    m.buttons.buttons = labels
    if focused >= 0 and focused < labels.Count() then m.buttons.focusButton = focused
end sub

' What Play plays: the work itself, or a show's episode up next; invalid when nothing plays.
function playTarget(work as object) as dynamic
    playable = [KivoApi.WorkKind.movie, KivoApi.WorkKind.episode, KivoApi.WorkKind.video, KivoApi.WorkKind.extra, KivoApi.WorkKind.book]
    for each kind in playable
        if work.kind = kind and work.available = true then return { id: work.id, positionMs: positionOf(work) }
    end for
    if work.series <> invalid and work.series.nextUp <> invalid
        return { id: work.series.nextUp.id, positionMs: positionOf(work.series.nextUp) }
    end if
    return invalid
end function

function positionOf(work as object) as dynamic
    if work.userState = invalid then return invalid
    return work.userState.positionMs
end function

' The details line: an episode's code, the year, the content rating and the runtime.
function details(work as object) as object
    parts = []
    if work.episode <> invalid then parts.Push(KivoUi.episodeCode(work.episode))
    if work.year <> invalid then parts.Push(work.year.ToStr())
    if work.contentRating <> invalid then parts.Push(work.contentRating)
    runtime = KivoUi.duration(work.durationMs)
    if runtime <> "" then parts.Push(runtime)
    return parts
end function

sub onChildren(event as object)
    response = event.GetData()
    m.tasks.children = invalid
    if response.code <> 200 then return
    children = response.body.items
    if m.work.kind = KivoApi.WorkKind.season
        m.seasons = [{ title: m.work.title, episodes: children }]
        showRows()
        return
    end if
    ' A show's seasons: each one's episodes, asked at once, shown in order once all have answered.
    m.seasons = []
    for i = 0 to children.Count() - 1
        m.seasons.Push({ title: children[i].title, episodes: invalid })
        task = Kivo.send(KivoApi.listWorkChildren(children[i].id), "onSeason")
        task.AddFields({ seasonIndex: i })
        m.tasks["season" + i.ToStr()] = task
    end for
end sub

sub onSeason(event as object)
    task = event.GetRoSGNode()
    i = task.seasonIndex
    m.tasks.Delete("season" + i.ToStr())
    response = event.GetData()
    m.seasons[i].episodes = []
    if response.code = 200 then m.seasons[i].episodes = response.body.items
    for each season in m.seasons
        if season.episodes = invalid then return
    end for
    showRows()
end sub

' The rows under the buttons: the episodes by season, More like this,
' extras, the work's collections and its cast. A reload keeps the focus
' on the card it was on, where that's still there.
sub showRows()
    root = CreateObject("roSGNode", "ContentNode")
    sizes = []
    heights = []
    if m.seasons <> invalid
        for each season in m.seasons
            if season.episodes <> invalid and season.episodes.Count() > 0 then addRow(root, sizes, heights, KivoContent.row(season.title, season.episodes, true), true)
        end for
    end if
    if m.work.similar <> invalid and m.work.similar.Count() > 0 then addRow(root, sizes, heights, KivoContent.row("More like this", m.work.similar, false), false)
    if m.work.extras <> invalid and m.work.extras.Count() > 0 then addRow(root, sizes, heights, KivoContent.row("Extras", m.work.extras, true), true)
    if m.work.collections <> invalid and m.work.collections.Count() > 0 then addRow(root, sizes, heights, KivoContent.collections("Collections", m.work.collections), false)
    if m.work.credits <> invalid and m.work.credits.Count() > 0 then addRow(root, sizes, heights, KivoContent.people("Cast & Crew", m.work.credits), false)
    if root.GetChildCount() = 0
        m.rows.visible = false
        return
    end if
    was = m.rows.rowItemFocused
    m.rows.rowItemSize = sizes
    m.rows.rowHeights = heights
    m.rows.content = root
    m.rows.visible = true
    if was <> invalid and was.Count() = 2 and was[0] >= 0 and was[0] < root.GetChildCount()
        if was[1] < root.GetChild(was[0]).GetChildCount() then m.rows.jumpToRowItem = was
    end if
    if m.buttons.buttons.Count() = 0 and not m.menu.visible then m.rows.SetFocus(true)
end sub

sub addRow(root as object, sizes as object, heights as object, row as object, landscape as boolean)
    size = KivoContent.rowSize(landscape)
    root.AppendChild(row)
    sizes.Push(size.item)
    heights.Push(size.height)
end sub

sub onButton()
    action = m.actions[m.buttons.buttonSelected]
    if action.tracks = true
        openMenu()
        return
    end if
    if m.work.kind = KivoApi.WorkKind.book
        ' A book plays in the book player, from its place or the start.
        params = { id: action.id }
        if action.fromStart then params.positionMs = 0
        m.top.navigate = { screen: "BookPlayerScreen", params: params }
        return
    end if
    params = { id: action.id, fromStart: action.fromStart }
    if action.id = m.work.id then params.Append(m.choice)
    m.top.navigate = { screen: "PlayerScreen", params: params }
end sub

' Whether the page offers Audio & Subtitles: a work with a version that
' has more than one audio track or any subtitle.
function picksTracks(work as object) as boolean
    v = KivoTracks.version(work, chosenVersion())
    if v = invalid then return false
    return KivoTracks.tracksOf(v, "audio").Count() > 1 or KivoTracks.tracksOf(v, "subtitle").Count() > 0 or work.versions.Count() > 1
end function

' Whether a pick here is remembered for the series rather than for the next play.
function remembers() as boolean
    return m.work.remembersTracks = true
end function

function chosenVersion() as string
    if m.choice.versionId <> invalid then return m.choice.versionId
    return ""
end function

' The menu's first page: each choice with the track a play starts with now.
sub openMenu()
    m.moreFrom = "page"
    v = KivoTracks.version(m.work, chosenVersion())
    items = []
    if KivoTracks.tracksOf(v, "audio").Count() > 0
        items.Push({ id: "audio", label: "Audio: " + KivoTracks.name(v, startsWith(v, "audio")) })
    end if
    subtitle = KivoTracks.name(v, startsWith(v, "subtitle"))
    if subtitle = "" then subtitle = "Off"
    items.Push({ id: "subtitle", label: "Subtitles: " + subtitle })
    if m.work.versions.Count() > 1 then items.Push({ id: "version", label: "Version: " + v.name })
    showMenu("menu", "Audio & Subtitles", items, "")
end sub

' The track of [kind] a play of version [v] starts with: the pick made
' here for a movie, else the server's (which follows the series' choice).
function startsWith(v as object, kind as string) as dynamic
    key = kind + "TrackId"
    if not remembers() and m.choice[key] <> invalid then return m.choice[key]
    return v[key]
end function

sub showMenu(page as string, title as string, items as object, checked as string)
    m.menuPage = page
    m.menu.title = title
    m.menu.note = ""
    if page <> "version" and remembers()
        if m.work.tracksRemembered = true
            m.menu.note = "Remembered for this show"
        else
            m.menu.note = "A pick here is kept for the whole show."
        end if
    end if
    m.menu.checkedId = checked
    m.menu.items = items
    m.menu.visible = true
    m.menu.callFunc("focus")
end sub

sub onMenuChosen()
    id = m.menu.chosen
    page = m.menuPage
    if page = "more" or page = "lists"
        onMoreChosen(id)
        return
    end if
    v = KivoTracks.version(m.work, chosenVersion())
    if page = "menu"
        if id = "version"
            showMenu("version", "Version", KivoTracks.versionItems(m.work), v.id)
        else
            showMenu(id, menuTitle(id), KivoTracks.items(v, id, automaticOf(v, id)), checkedOf(v, id))
        end if
        return
    end if
    if page = "version"
        ' A version change resets the picks: tracks belong to one version.
        m.choice = { versionId: id }
        openMenu()
        return
    end if
    key = page + "TrackId"
    if remembers()
        body = {}
        body[key] = id
        m.tasks.tracks = Kivo.send(KivoApi.updateWorkTracks(m.work.id, body), "onTracks")
        return
    end if
    if id = KivoTracks.automatic
        m.choice.Delete(key)
    else
        m.choice[key] = id
    end if
    openMenu()
end sub

function menuTitle(kind as string) as string
    if kind = "audio" then return "Audio"
    return "Subtitles"
end function

' The track "Default" stands for: without the series' choice for an
' episode that remembers tracks, else the server's own.
function automaticOf(v as object, kind as string) as dynamic
    if kind = "audio"
        if remembers() then return v.defaultAudioTrackId
        return v.audioTrackId
    end if
    if remembers() then return v.defaultSubtitleTrackId
    return v.subtitleTrackId
end function

' The item checked: the series' choice or this page's pick, else Default.
function checkedOf(v as object, kind as string) as string
    key = kind + "TrackId"
    if remembers()
        if m.work.tracksRemembered <> true then return KivoTracks.automatic
        if v[key] = invalid then return KivoTracks.off
        return v[key]
    end if
    if m.choice[key] <> invalid then return m.choice[key]
    return KivoTracks.automatic
end function

' The series' choice changed; the page shows the tracks plays start with now.
sub onTracks(event as object)
    response = event.GetData()
    m.tasks.tracks = invalid
    if response.code = 200
        m.work = response.body
        show(m.work)
    else if response.code = 409
        ' Remembering was turned off meanwhile: the pick is for the next play.
        m.work.remembersTracks = false
    end if
    openMenu()
end sub

sub onMenuClosed()
    if m.menuPage = "lists"
        openMore()
        return
    end if
    if m.menuPage <> "menu" and m.menuPage <> "more"
        openMenu()
        return
    end if
    closeMenu()
end sub

sub closeMenu()
    m.menu.visible = false
    m.menuPage = invalid
    if m.moreFrom = "rows" and m.rows.visible
        m.rows.SetFocus(true)
    else if m.buttons.buttons.Count() > 0
        m.buttons.SetFocus(true)
    else
        takeFocus()
    end if
end sub

' More, on *: for the card in focus in the rows, else for the page's
' work, mark it watched or unwatched; for the page's work, add it to or
' take it off a list; an episode card's series.
sub openMore()
    m.moreFrom = "page"
    m.moreWork = { id: m.work.id, played: m.work.userState <> invalid and m.work.userState.played = true, kind: m.work.kind }
    if m.rows.IsInFocusChain() and m.rows.content <> invalid
        at = m.rows.rowItemFocused
        card = m.rows.content.GetChild(at[0]).GetChild(at[1])
        if card = invalid or card.workId = "" then return
        m.moreFrom = "rows"
        m.moreWork = { id: card.workId, played: card.played, kind: card.kind }
    end if
    items = []
    if m.moreWork.played
        items.Push({ id: "unplayed", label: "Mark as unwatched" })
    else
        items.Push({ id: "played", label: "Mark as watched" })
    end if
    if m.moreFrom = "page" then items.Push({ id: "lists", label: "Add to list…" })
    if m.moreFrom = "page" and m.work.episode <> invalid then items.Push({ id: "series", label: "Go to series" })
    m.menuPage = "more"
    m.menu.title = "More"
    m.menu.note = ""
    m.menu.checkedId = ""
    m.menu.items = items
    m.menu.visible = true
    m.menu.callFunc("focus")
end sub

sub onMoreChosen(id as string)
    if m.menuPage = "lists"
        toggleList(id)
        return
    end if
    if id = "played" or id = "unplayed"
        closeMenu()
        m.tasks.played = Kivo.send(KivoApi.updateWorkUserState(m.moreWork.id, { played: id = "played" }), "onPlayed")
    else if id = "lists"
        m.tasks.lists = Kivo.send(KivoApi.listLists(), "onLists")
    else if id = "series"
        closeMenu()
        m.top.navigate = { screen: "DetailScreen", params: { id: m.work.episode.seriesId } }
    end if
end sub

sub onPlayed(event as object)
    m.tasks.played = invalid
    if event.GetData().code <> 200
        m.status.text = KivoDisplay.problem(event.GetData())
        return
    end if
    load()
end sub

' The user's lists that hold works by hand, each checked when it holds the page's work.
sub onLists(event as object)
    m.tasks.lists = invalid
    response = event.GetData()
    if response.code <> 200
        m.status.text = KivoDisplay.problem(response)
        closeMenu()
        return
    end if
    m.lists = []
    for each list in response.body.items
        if list.kind = KivoApi.ListKind.manual then m.lists.Push(list)
    end for
    showLists()
end sub

sub showLists()
    held = {}
    if m.work.listIds <> invalid
        for each listId in m.work.listIds
            held[listId] = true
        end for
    end if
    items = []
    for each list in m.lists
        label = list.name
        if held[list.id] = true then label = "✓ " + label
        items.Push({ id: list.id, label: label })
    end for
    m.menuPage = "lists"
    m.menu.title = "Lists"
    m.menu.note = ""
    if items.Count() = 0 then m.menu.note = "Make a list in Kivo on another device first."
    m.menu.checkedId = ""
    m.menu.items = items
    m.menu.visible = true
    m.menu.callFunc("focus")
end sub

' Puts the page's work on the list, or takes it off when it's there.
sub toggleList(listId as string)
    held = false
    if m.work.listIds <> invalid
        for each id in m.work.listIds
            if id = listId then held = true
        end for
    end if
    if held
        m.tasks.list = Kivo.send(KivoApi.removeListWork(listId, m.work.id), "onListChanged")
    else
        m.tasks.list = Kivo.send(KivoApi.addListWork(listId, { workId: m.work.id }), "onListChanged")
    end if
end sub

sub onListChanged(event as object)
    m.tasks.list = invalid
    response = event.GetData()
    if response.code >= 300
        m.menu.note = KivoDisplay.problem(response)
        return
    end if
    m.tasks.work = Kivo.send(KivoApi.getWork(m.work.id), "onListWork")
end sub

sub onListWork(event as object)
    m.tasks.work = invalid
    response = event.GetData()
    if response.code = 200 then m.work = response.body
    if m.menuPage = "lists" then showLists()
end sub

sub onCard()
    at = m.rows.rowItemSelected
    m.top.navigate = KivoContent.target(m.rows.content.GetChild(at[0]).GetChild(at[1]))
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if key = "options" and m.work <> invalid and not m.menu.visible
        openMore()
        return true
    end if
    if key = "down" and m.buttons.IsInFocusChain() and m.rows.visible
        m.rows.SetFocus(true)
        return true
    end if
    if key = "up" and m.rows.IsInFocusChain() and m.buttons.buttons.Count() > 0
        m.buttons.SetFocus(true)
        return true
    end if
    return false
end function
