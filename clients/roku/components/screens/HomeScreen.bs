import "pkg:/source/generated/api.bs"
import "pkg:/source/generated/tokens.bs"
import "pkg:/source/shared/content.bs"
import "pkg:/source/shared/display.bs"
import "pkg:/source/shared/session.bs"
import "pkg:/source/shared/ui.bs"

sub init()
    m.rows = m.top.FindNode("rows")
    m.status = m.top.FindNode("status")
    KivoUi.style(m.top.FindNode("heading"), KivoTokens.TextSize.xl, KivoTokens.Color.text, true)
    KivoUi.style(m.status, KivoTokens.TextSize.base, KivoTokens.Color.textMuted)
    font = CreateObject("roSGNode", "Font")
    font.uri = "font:BoldSystemFontFile"
    font.size = KivoTokens.TextSize.base
    m.rows.rowLabelFont = font
    m.rows.rowLabelColor = KivoTokens.Color.text
    m.rows.ObserveField("rowItemSelected", "onSelected")
    KivoUi.style(m.top.FindNode("hint"), KivoTokens.TextSize.sm, KivoTokens.Color.textSubtle)
    m.nav = m.top.FindNode("nav")
    m.nav.ObserveField("chosen", "onNav")
    m.nav.ObserveField("closed", "closeNav")
    m.more = m.top.FindNode("more")
    m.more.ObserveField("chosen", "onMore")
    m.more.ObserveField("closed", "closeMore")
    m.libraries = []
    load()
end sub

sub focus()
    if m.nav.visible
        m.nav.callFunc("focus")
        return
    end if
    if m.more.visible
        m.more.callFunc("focus")
        return
    end if
    m.rows.SetFocus(true)
    ' What's in progress may have changed while another screen showed.
    if m.loaded = true then load()
end sub

sub load()
    m.task = Kivo.send(KivoApi.getHome(), "onHome")
    m.librariesTask = Kivo.send(KivoApi.listLibraries(), "onLibraries")
end sub

' The libraries the user sees, pinned ones first, for the menu.
sub onLibraries(event as object)
    m.librariesTask = invalid
    response = event.GetData()
    if response.code <> 200 then return
    pinned = []
    others = []
    for each lib in response.body.items
        if lib.pinned = true
            pinned.Push(lib)
        else
            others.Push(lib)
        end if
    end for
    pinned.Append(others)
    m.libraries = pinned
end sub

' The menu: each library, then the app's other pages.
sub openNav()
    items = [{ id: "search", label: "Search" }]
    for each lib in m.libraries
        items.Push({ id: "library:" + lib.id, label: lib.name })
    end for
    items.Push({ id: "lists", label: "Lists" })
    items.Push({ id: "settings", label: "Settings" })
    m.nav.title = "Kivo"
    m.nav.checkedId = ""
    m.nav.items = items
    m.nav.visible = true
    m.nav.callFunc("focus")
end sub

sub closeNav()
    m.nav.visible = false
    m.rows.SetFocus(true)
end sub

sub onNav()
    id = m.nav.chosen
    closeNav()
    if id = "search"
        m.top.navigate = { screen: "SearchScreen", params: {} }
    else if id = "lists"
        m.top.navigate = { screen: "ListsScreen", params: {} }
    else if id = "settings"
        m.top.navigate = { screen: "SettingsScreen", params: {} }
    else if id.Left(8) = "library:"
        libraryId = id.Mid(8)
        for each lib in m.libraries
            if lib.id = libraryId then m.top.navigate = { screen: "LibraryScreen", params: { id: lib.id, name: lib.name, kind: lib.kind } }
        end for
    end if
end sub

sub onHome(event as object)
    response = event.GetData()
    m.task = invalid
    if response.code = 401
        m.top.navigate = { signedOut: true }
        return
    end if
    if response.code <> 200
        m.status.text = KivoDisplay.problem(response) + " Press OK to try again."
        return
    end if
    m.loaded = true
    root = CreateObject("roSGNode", "ContentNode")
    sizes = []
    heights = []
    m.rowKinds = []
    for each row in response.body.rows
        title = rowTitle(row)
        if title <> invalid and row.items.Count() > 0
            landscape = row.kind = KivoApi.HomeRowKind.continueWatching
            root.AppendChild(KivoContent.row(title, row.items, landscape))
            m.rowKinds.Push(row.kind)
            size = KivoContent.cardSize(landscape)
            sizes.Push([size[0], size[1] + KivoContent.captionHeight])
            heights.Push(size[1] + KivoContent.captionHeight + 60)
        end if
    end for
    if root.GetChildCount() = 0
        m.status.text = "Nothing to show yet. Add a library on the server, or show its rows on Home."
        return
    end if
    m.status.text = ""
    ' A reload keeps the focus on the card it was on, where that's still there.
    was = m.rows.rowItemFocused
    m.rows.rowItemSize = sizes
    m.rows.rowHeights = heights
    m.rows.content = root
    if was <> invalid and was.Count() = 2 and was[0] >= 0 and was[0] < root.GetChildCount()
        if was[1] < root.GetChild(was[0]).GetChildCount() then m.rows.jumpToRowItem = was
    end if
end sub

' A Home row's title, as the other apps word it; invalid for a kind this app doesn't know.
function rowTitle(row as object) as dynamic
    if row.kind = KivoApi.HomeRowKind.continueWatching then return "Continue Watching"
    if row.kind = KivoApi.HomeRowKind.continueListening then return "Continue Listening"
    if row.kind = KivoApi.HomeRowKind.list and row.list <> invalid then return row.list.name
    if row.kind = KivoApi.HomeRowKind.recentlyAdded
        if row.library <> invalid then return "Recently Added in " + row.library.name
        return "Recently Added"
    end if
    return invalid
end function

sub onSelected()
    at = m.rows.rowItemSelected
    m.top.navigate = KivoContent.target(m.rows.content.GetChild(at[0]).GetChild(at[1]))
end sub

' * on a card: what can be done with its work.
sub openMore()
    if m.rows.content = invalid then return
    at = m.rows.rowItemFocused
    card = m.rows.content.GetChild(at[0]).GetChild(at[1])
    if card = invalid or card.workId = "" then return
    m.moreCard = card
    items = []
    if card.played
        items.Push({ id: "unplayed", label: "Mark as unwatched" })
    else
        items.Push({ id: "played", label: "Mark as watched" })
    end if
    kind = m.rowKinds[at[0]]
    if kind = KivoApi.HomeRowKind.continueWatching then items.Push({ id: "continue", label: "Remove from Continue Watching" })
    if kind = KivoApi.HomeRowKind.continueListening then items.Push({ id: "continue", label: "Remove from Continue Listening" })
    m.more.title = card.title
    m.more.checkedId = ""
    m.more.items = items
    m.more.visible = true
    m.more.callFunc("focus")
end sub

sub closeMore()
    m.more.visible = false
    m.rows.SetFocus(true)
end sub

sub onMore()
    id = m.more.chosen
    workId = m.moreCard.workId
    closeMore()
    if id = "played" or id = "unplayed"
        m.changeTask = Kivo.send(KivoApi.updateWorkUserState(workId, { played: id = "played" }), "onChanged")
    else if id = "continue"
        m.changeTask = Kivo.send(KivoApi.removeFromContinue(workId), "onChanged")
    end if
end sub

sub onChanged(event as object)
    m.changeTask = invalid
    response = event.GetData()
    if response.code >= 300
        m.status.text = KivoDisplay.problem(response)
        return
    end if
    load()
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if press and key = "options" and not m.nav.visible and not m.more.visible
        openMore()
        return true
    end if
    if press and key = "OK" and m.loaded <> true
        load()
        return true
    end if
    if press and key = "left" and not m.nav.visible
        openNav()
        return true
    end if
    return false
end function
