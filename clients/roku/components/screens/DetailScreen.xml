<?xml version="1.0" encoding="utf-8" ?>
<!-- A work's page: its backdrop, title, details and overview, Play or
     Resume, and for a show or a season its episodes by season. -->
<component name="DetailScreen" extends="KivoScreen">
  <children>
    <Poster id="backdrop" width="1920" height="1080" loadDisplayMode="scaleToZoom" />
    <Rectangle id="scrim" width="1920" height="1080" />
    <Label id="title" translation="[96, 96]" width="1300" wrap="true" maxLines="2" />
    <Label id="details" translation="[96, 230]" width="1300" />
    <Label id="overview" translation="[96, 290]" width="1100" wrap="true" maxLines="4" />
    <ButtonGroup id="buttons" translation="[96, 480]" layoutDirection="horiz" itemSpacings="[24]" minWidth="320" />
    <Label id="status" translation="[96, 590]" width="1700" wrap="true" />
    <RowList id="episodes" translation="[96, 600]" itemComponentName="PosterItem"
      itemSize="[1824, 420]" numRows="2" rowItemSize="[[480, 350]]" rowHeights="[420]"
      rowItemSpacing="[[24, 0]]" itemSpacing="[0, 40]" showRowLabel="[true]" rowLabelOffset="[[0, 12]]"
      rowFocusAnimationStyle="floatingFocus" visible="false" />
  </children>
</component>
