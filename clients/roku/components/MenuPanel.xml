<?xml version="1.0" encoding="utf-8" ?>
<!-- A panel along the right edge, or the left with side "left", listing items, each { id, label }, under
     a title and an optional note. With checkedId set it's a choice: the
     items show as radio buttons with that one checked. Choosing an item
     sets chosen to its id; Back sets closed. -->
<component name="MenuPanel" extends="Group">
  <interface>
    <field id="side" type="string" value="right" onChange="onSide" />
    <field id="title" type="string" onChange="onTitle" />
    <field id="note" type="string" onChange="onTitle" />
    <field id="items" type="array" onChange="onItems" />
    <field id="checkedId" type="string" />
    <field id="chosen" type="string" alwaysNotify="true" />
    <field id="closed" type="boolean" alwaysNotify="true" />
    <function name="focus" />
  </interface>
  <children>
    <Rectangle id="ground" translation="[1200, 0]" width="720" height="1080" />
    <Label id="heading" translation="[1264, 72]" width="592" />
    <Label id="noteLabel" translation="[1264, 128]" width="592" wrap="true" maxLines="2" />
    <LabelList id="list" translation="[1264, 200]" itemSize="[592, 64]" numRows="12" vertFocusAnimationStyle="floatingFocus" />
    <RadioButtonList id="radio" translation="[1264, 200]" itemSize="[592, 64]" numRows="12" vertFocusAnimationStyle="floatingFocus" visible="false" />
  </children>
</component>
