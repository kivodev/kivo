<?xml version="1.0" encoding="utf-8" ?>
<!-- Sends one request (a KivoApi function's) to the server and sets
     response to { code, body, error }: the HTTP status, the answer as
     ParseJson gives it, and why it failed when no answer came. -->
<component name="ApiTask" extends="Task">
  <interface>
    <field id="request" type="assocarray" />
    <!-- The server's base URL; empty for the saved server's. -->
    <field id="base" type="string" />
    <field id="response" type="assocarray" />
  </interface>
</component>
