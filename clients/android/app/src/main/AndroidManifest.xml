<?xml version="1.0" encoding="utf-8"?>
<!-- One APK for Android TV, Google TV, Fire TV and phones. It runs
     without a touch screen, and lists itself on the TV launchers with its
     banner and on a phone's with its icon. Servers on the home network are plain HTTP, so cleartext is
     allowed. Nothing is backed up: allowBackup before Android 12, the
     extraction rules after. Continue Watching goes to the
     launcher's Watch Next row, each opening its work by a kivo://work link. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reaching a server on the home network and finding it by DNS-SD:
         asked for at sign-in from Android 17, granted with INTERNET before. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Hearing the network change, to reach the server at the address that
         answers on the new one. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The phone's playback service: a book, or a video in picture in picture, playing on with the
         screen off or the app in the background, with its media notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Voice input for Search, where the TV has it. -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".KivoApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kivo"
        android:usesCleartextTraffic="true"
        tools:ignore="DataExtractionRules">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A Watch Next program opens its work's page. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="kivo" android:host="work" />
            </intent-filter>
        </activity>

        <!-- The phone's media session, which the notification, lock screen and headphones reach. -->
        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- The Watch Next row's artwork, which the launcher reads. -->
        <provider
            android:name=".watchnext.ArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>
